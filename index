  <div class="toast" role="status" aria-live="polite"></div>

  <script>
    const form = document.querySelector("#task-search");
    const taskInput = document.querySelector("#task-input");
    const locationInput = document.querySelector("#location-input");
    const toast = document.querySelector(".toast");
    let toastTimer;

    function showMessage(message) {
      toast.textContent = message;
      toast.classList.add("show");
      clearTimeout(toastTimer);
      toastTimer = setTimeout(() => toast.classList.remove("show"), 3500);
    }

    form.addEventListener("submit", (event) => {
      event.preventDefault();

      const task = taskInput.value.trim();
      const location = locationInput.value.trim();

      if (!task) {
        taskInput.focus();
        showMessage("What would you like help with? Add a task to get started.");
        return;
      }

      showMessage(
        `You're looking for “${task}”${location ? ` near ${location}` : ""}. Task matching is coming soon!`
      );
    });

    document.querySelectorAll("[data-task]").forEach((item) => {
      item.addEventListener("click", () => {
        taskInput.value = item.dataset.task;
        taskInput.focus();
      });
    });

    document.querySelector("#year").textContent = new Date().getFullYear();
  </script>
